# ===== Reelay 配置示例 =====
# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，不会提交。
# 凭证等同账号密码，务必妥善保管、勿泄露、勿上传公开仓库。

# ---- Telegram userbot（在 my.telegram.org 申请）----
REELAY_TG_API_ID=123456
REELAY_TG_API_HASH=your_api_hash_here
REELAY_TG_SESSION=data/userbot.session
REELAY_CONTROL_BOT_SESSION=data/controlbot.session

# 控制 bot（用于 /status /failed /pending /retry 与审批按钮）
REELAY_CONTROL_BOT_TOKEN=
# 你自己的 Telegram 数字 id（控制 bot 只服务这个 id；给 @userinfobot 发消息可得）
REELAY_OWNER_ID=

# ---- 115 网盘：混合鉴权（cookie + 开放平台 OAuth）----
# cookie：负责分享枚举/转存、列目录/读属性（必须配，转存链路依赖它）。
# 推荐在 Web 控制台「连接状态」点击“扫码获取 Cookie”，扫码后自动保存和探活；
# 默认绑定独立 TV 设备会话，减少与现有网页端登录互踢。手动填写仅作为兜底。
REELAY_115_COOKIES=UID=...;CID=...;SEID=...;KID=...
# Cookie 扫码绑定的设备类型（默认 tv；通常无需修改）
# REELAY_115_COOKIE_QR_APP=tv
#
# OAuth（可选，推荐）：负责建目录/改名/移动/删除等写操作。无需在此手填——
# 在 Web 控制台点「授权开放平台」，用 115 App 扫码即自动获取并
# 回写 access_token / refresh_token；access_token 过期后用 refresh_token
# 自动续期。仅在想用自己的开放应用或 CI 预置时才需要下面三项：
# REELAY_115_APP_ID=100195125
# REELAY_115_ACCESS_TOKEN=
# REELAY_115_REFRESH_TOKEN=
# 凭证文件路径（默认 data/115_credentials.json）：
# REELAY_115_OAUTH_FILE=data/115_credentials.json
# 请求治理：Open/Cookie/分享接口分级限流，触发 429/访问上限后统一冷却。
# REELAY_115_OPEN_QPS=3
# REELAY_115_COOKIE_QPS=2
# REELAY_115_SHARE_QPS=1
# REELAY_115_RISK_COOLDOWN_SEC=3600
# OAuth access_token 默认按 2 小时估算，并提前 15 分钟主动刷新。
# REELAY_115_OAUTH_LIFETIME_SEC=7200
# REELAY_115_OAUTH_REFRESH_ADVANCE_SEC=900

# ---- AI 解析（OpenAI 兼容接口）----
REELAY_LLM_BASE_URL=https://api.openai.com/v1
REELAY_LLM_API_KEY=sk-xxx
REELAY_LLM_MODEL=gpt-4o-mini

# ---- TMDB 元数据匹配（可选；不配则沿用 AI 标题）----
REELAY_TMDB_API_KEY=
# REELAY_TMDB_BASE_URL=https://api.themoviedb.org/3   # 国内连不上时可改用官方备用域名 https://api.tmdb.org/3

# ---- 运行参数 ----
REELAY_DB_PATH=data/reelay.db
REELAY_CONFIG_PATH=config.yaml
REELAY_WORKER_CONCURRENCY=3
REELAY_LOG_LEVEL=INFO
# 外部扩展目录（多个用 : 分隔），放入 *.py 即被发现；Docker 部署挂载 deploy/plugins。
# REELAY_PLUGIN_DIRS=plugins
# 重连后按来源水位补拉停机期间的消息：每个来源最多条数（0 关闭）与最大消息年龄（天）。
# REELAY_TG_BACKFILL_LIMIT=200
# REELAY_TG_BACKFILL_MAX_DAYS=7
# 消息源断开超过该秒数后告警一次，恢复后发送恢复通知。
# REELAY_SOURCE_ALERT_SEC=120
# LLM 超时/限流/5xx 的退避重试次数与首次间隔（秒），仍失败才降级 regex 并转人工。
# REELAY_LLM_RETRIES=2
# REELAY_LLM_RETRY_DELAY=2
# 115 凭证探活间隔（秒）；凭证失效暂停转存期间固定 30 秒探活，恢复后自动继续。
# REELAY_115_AUTH_CHECK_SEC=300

# ---- Web 控制台 ----
REELAY_WEB_HOST=127.0.0.1
REELAY_WEB_PORT=28080
# 设了密码后网页访问需登录（建议暴露到非本机时必填）；留空则免登录
# REELAY_WEB_PASSWORD=
# worker/web 日志落盘文件（供网页查看）；留空则仅输出到控制台
REELAY_LOG_FILE=data/reelay.log
# STRM 播放跳转的签名密钥；留空则自动生成并保存到 data/strm.secret
# REELAY_STRM_SECRET=

# ---- MCP（供 Claude 等外部 agent 调用，python -m reelay.mcp_server）----
# 设为 1 只暴露查询类工具，不暴露审批/忽略/重试
# REELAY_MCP_READONLY=1
