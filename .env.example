# ===== Reelay 环境变量 =====
# 配置与密钥都在管理台「设置」中修改（保存在 data/config.yaml 与 data/secrets.json），这里只有部署参数，没有也能启动。
# .env 已被 .gitignore 忽略，不会提交。

# ---- Docker 镜像版本（仅 Docker Compose 部署）----
# 不写时用 latest（最新正式版）；固定版本便于回滚，例如 REELAY_VERSION=1.0.0
# REELAY_VERSION=

# ---- Web 管理台监听地址（本机运行时使用；Docker 部署改 compose.yaml 的 ports）----
# 没有设置登录密码时管理台只接受本机地址访问；要从其他设备访问，先在「设置 → 运行与安全」设置密码。
REELAY_WEB_HOST=127.0.0.1
REELAY_WEB_PORT=28080

# ---- 反向代理（见 docs/deployment.md）----
# 信任这些地址转发的真实客户端地址（X-Forwarded-For），登录失败限流才按真实客户端计数；默认只信任 127.0.0.1
# REELAY_FORWARDED_ALLOW_IPS=172.18.0.1

# ---- MCP 只读模式（见 docs/agents.md）----
# 设为 1 时 stdio 与 HTTP 的 /mcp 都只提供查询工具，不提供批准、忽略、重试与订阅
# REELAY_MCP_READONLY=1
