# ===== Reelay 配置示例 =====
# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，不会提交。
# 凭证等同账号密码，务必妥善保管、勿泄露、勿上传公开仓库。

# ---- Telegram userbot（在 my.telegram.org 申请）----
REELAY_TG_API_ID=123456
REELAY_TG_API_HASH=your_api_hash_here
REELAY_TG_SESSION=data/userbot.session
REELAY_CONTROL_BOT_SESSION=data/controlbot.session

# 控制 bot（用于 /status /failed /pending /retry 与审批按钮）
REELAY_CONTROL_BOT_TOKEN=
# 你自己的 Telegram 数字 id（控制 bot 只服务这个 id；给 @userinfobot 发消息可得）
REELAY_OWNER_ID=

# ---- 115 网盘登录态（当前实现仅支持 cookie）----
REELAY_115_COOKIES=UID=...;CID=...;SEID=...;KID=...

# ---- AI 解析（OpenAI 兼容接口）----
REELAY_LLM_BASE_URL=https://api.openai.com/v1
REELAY_LLM_API_KEY=sk-xxx
REELAY_LLM_MODEL=gpt-4o-mini

# ---- TMDB 元数据匹配（可选；不配则沿用 AI 标题）----
REELAY_TMDB_API_KEY=
# REELAY_TMDB_BASE_URL=https://api.themoviedb.org/3   # 需要代理时可改

# ---- 运行参数 ----
REELAY_DB_PATH=data/reelay.db
REELAY_CONFIG_PATH=config.yaml
REELAY_WORKER_CONCURRENCY=3
REELAY_LOG_LEVEL=INFO

# ---- Web 控制台 ----
REELAY_WEB_HOST=127.0.0.1
REELAY_WEB_PORT=28080
# 设了密码后网页访问需登录（建议暴露到非本机时必填）；留空则免登录
# REELAY_WEB_PASSWORD=
# worker/web 日志落盘文件（供网页查看）；留空则仅输出到控制台
REELAY_LOG_FILE=data/reelay.log
