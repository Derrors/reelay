# ===== Reelay 环境变量 =====
# 配置与密钥都在管理台「设置」中修改（保存在 data/config.yaml 与 data/secrets.json），这里只剩部署参数。
# .env 已被 .gitignore 忽略，不会提交。

# ---- Docker 镜像版本（仅 Docker Compose 部署）----
# 不写时用 latest（最新正式版）；固定版本便于回滚，例如 REELAY_VERSION=0.3.0
# REELAY_VERSION=

# ---- Web 管理台监听地址 ----
# 暴露到本机以外时，务必在管理台「设置 → 运行与安全」设置登录密码。
REELAY_WEB_HOST=127.0.0.1
REELAY_WEB_PORT=28080

# ---- MCP（供 Claude 等外部 agent 调用，python -m reelay.mcp_server）----
# 设为 1 只暴露查询类工具，不暴露审批/忽略/重试
# REELAY_MCP_READONLY=1

# ---- 从旧版本升级 ----
# 旧版本写在这里的 REELAY_LLM_API_KEY、REELAY_TG_API_ID、REELAY_115_COOKIES 等变量，首次启动时会自动导入
# 管理台（见 docs/configuration.md「从旧版本升级」），之后可以删掉。
